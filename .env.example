# Copy to .env for local development. In production these are Fly secrets:
#   fly secrets set FOOTBALL_API_KEY=... SESSION_SECRET=...

# football-data.org API key — used server-side only, never sent to browsers.
# Free registration: https://www.football-data.org/client/register
FOOTBALL_API_KEY=your_football_data_org_key_here

# Signs session cookies. Any long random string will do:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it signs everyone out.
SESSION_SECRET=generate_a_long_random_string

# Where the SQLite file lives. Defaults to ./.data/epl.db locally and
# /data/epl.db (the Fly volume) in production.
# DATABASE_PATH=./.data/epl.db
